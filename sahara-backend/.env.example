# ============================================
# Sahara Fuel SaaS - Environment Variables
# ============================================

# Server
NODE_ENV=development
PORT=3000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sahara_fuel
DB_USER=sahara_admin
DB_PASSWORD=your_strong_password

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=change_this_to_64_char_secret_key_for_production_use_only_12345
JWT_REFRESH_SECRET=change_this_to_another_64_char_key_for_refresh_tokens_67890
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# CORS
CORS_ORIGIN=*

# Logging
LOG_LEVEL=info
