# ============================================================
# Sahara Fuel SaaS - Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit the .env file to version control
# ============================================================

# Server
NODE_ENV=development
PORT=3000

# PostgreSQL Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sahara_fuel
DB_USER=sahara_admin
DB_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD

# Redis Cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Authentication (Generate strong random keys for production!)
# Use: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_GENERATE_64_CHAR_RANDOM_KEY
JWT_REFRESH_SECRET=CHANGE_ME_GENERATE_ANOTHER_64_CHAR_KEY
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# CORS (comma-separated origins for production)
CORS_ORIGIN=http://localhost:8080,http://localhost:3000

# Logging
LOG_LEVEL=info
